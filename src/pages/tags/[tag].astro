---
import ListHeader from '../../components/ListHeader.astro';
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, tagSlug, type Post } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	const tags = new Map<string, string>();
	for (const t of posts.flatMap((p) => p.data.tags)) tags.set(tagSlug(t), t);
	return [...tags].map(([slug, label]) => ({
		params: { tag: slug },
		props: { label, posts: posts.filter((p) => p.data.tags.some((t) => tagSlug(t) === slug)) },
	}));
}

const { label, posts } = Astro.props as { label: string; posts: Post[] };
---

<BaseLayout title={`#${label}`} description={`${label} 태그가 달린 글 목록`}>
	<div class="wrap">
		<ListHeader title={`#${label}`} description={`${posts.length}개의 글`} />
		<PostList posts={posts} />
	</div>
</BaseLayout>
