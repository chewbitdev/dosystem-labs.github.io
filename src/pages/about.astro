---
import { COMPANY_URL } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';

const areas = [
	{
		title: '금융 서비스 구축',
		body: '온·오프라인 결제, 마이데이터, 금융사 인증·보안 솔루션 연계, SAP 연계(Silver Partner)까지 높은 안정성이 필요한 금융 서비스를 구축합니다.',
	},
	{ title: '웹·앱 서비스 구축', body: '웹·앱 서비스와 반응형 웹사이트를 구축하고, 웹·앱 접근성과 사용성을 개선합니다.' },
	{ title: '서비스 운영', body: '상주·비상주 형태로 구축한 서비스를 안정적으로 운영합니다.' },
	{
		title: '컨설팅',
		body: 'UX 컨설팅과 UI/UX 개선, BX 정립, 시스템 통합·고도화 전략, 비즈니스 아키텍처 컨설팅을 수행합니다.',
	},
];

const teams = [
	{ name: '경영지원팀', body: '회사 운영과 지원' },
	{ name: '사업관리', body: '프로젝트 관리, PMO, 검증' },
	{ name: 'DT', body: '서버, 프론트엔드, 네이티브 개발' },
	{ name: '기업부설연구소', body: 'R&D, 솔루션 개발, 서비스 운영' },
];

const welfare = [
	{ title: '포상 제도', items: ['장기근속자 포상', '우수 사원 표창', '자격증 취득 특별 포상'] },
	{ title: '휴가 및 휴직', items: ['연차(반차)/하계휴가', 'ReFresh 휴가', '경조휴가', '산전/후 휴가', '육아휴직 제공'] },
	{
		title: '교육 및 자기계발',
		items: ['직군별 업무 교육', '세미나 참여 지원', '국가공인 자격증 취득 지원', '신입사원 교육(OJT)', '도서 구입비 지원', '기타 자기계발비 지원'],
	},
	{ title: '건강검진', items: ['2년에 1회 직장 건강검진 지원'] },
	{ title: '경조사 및 기타', items: ['각종 경조사 시 경조금, 화환 지원', '정기 회식비 지원', '정기 워크숍', '간식/음료 제공'] },
];

const clients = ['신한은행', '신한카드', '신한투자증권', 'GS리테일', '티머니', '삼성전자'];
---

<BaseLayout title="About" description="DO SYSTEM과 dosystem labs 기술 블로그를 소개합니다.">
	<div class="wrap about">
		<header class="head">
			<h1>DO SYSTEM은 새롭고 혁신적인 고객 가치를 창조하는 소프트웨어 회사입니다.</h1>
			<p>
				2024년 8월에 설립되어 SI 구축·운영과 소프트웨어 개발·서비스를 해 왔고, dosystem labs는 그 과정에서 개발자들이 배우고 고민한 내용을 나누기 위해 만든 기술 블로그입니다. 멘토링에서
				오간 질문과 스터디에서 정리한 내용을 꾸준히 기록합니다.
			</p>
		</header>

		<section>
			<h2>하는 일</h2>
			<dl class="areas">
				{
					areas.map((a) => (
						<div>
							<dt>{a.title}</dt>
							<dd>{a.body}</dd>
						</div>
					))
				}
			</dl>
		</section>

		<section>
			<h2>함께 일하는 팀</h2>
			<dl class="teams">
				{
					teams.map((t) => (
						<div>
							<dt>{t.name}</dt>
							<dd>{t.body}</dd>
						</div>
					))
				}
			</dl>
		</section>

		<section>
			<h2>자체 솔루션</h2>
			<p>
				Next.js 기반 프론트엔드 프레임워크 Confy와 디자인 시스템을 직접 개발해, 세션 관리와 App Bridge 통신 같은 업무 공통
				기능과 일관된 UI 컴포넌트를 프로젝트에 제공합니다.
			</p>
		</section>

		<section>
			<h2>함께한 고객</h2>
			<p class="clients">{clients.join(' · ')}</p>
		</section>

		<section>
			<h2>복지</h2>
			<div class="welfare">
				{
					welfare.map((w) => (
						<div>
							<h3>{w.title}</h3>
							<ul>
								{w.items.map((i) => (
									<li>{i}</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</section>

		<section class="contact">
			<h2>문의</h2>
			<p>
				프로젝트나 채용 관련 문의는 <a href="mailto:dosystem@dosystem.kr">dosystem@dosystem.kr</a>로 보내주세요. 회사에 대한
				더 자세한 내용은 <a href={COMPANY_URL} target="_blank" rel="noopener">DO SYSTEM 홈페이지</a>에서 볼 수 있습니다.
			</p>
			<p class="addr">서울특별시 용산구 한강대로 366, 809호 (동자동, 트윈시티 남산) · Tel 02-2135-5388</p>
		</section>
	</div>
</BaseLayout>

<style>
	.about {
		max-width: 860px;
	}
	.head {
		padding: 4.5rem 0 3rem;
	}
	h1 {
		font-size: clamp(1.7rem, 4.2vw, 2.5rem);
		font-weight: 800;
		line-height: 1.3;
		letter-spacing: -0.035em;
	}
	.head p {
		margin: 1.25rem 0 0;
		max-width: 40rem;
		font-size: 1.08rem;
	}
	section {
		padding-block: 2.5rem;
		border-top: 1px solid var(--line);
	}
	h2 {
		font-size: 1.15rem;
		margin-bottom: 1.5rem;
	}
	dl {
		margin: 0;
		display: grid;
		gap: 1.5rem 2rem;
	}
	.areas {
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
	}
	.teams {
		grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
	}
	dt {
		color: var(--ink);
		font-weight: 700;
	}
	.areas dt {
		padding-top: 0.75rem;
		border-top: 2px solid var(--brand);
	}
	dd {
		margin: 0.4rem 0 0;
		font-size: 0.95rem;
		color: var(--muted);
	}
	.welfare {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 2rem;
	}
	.welfare h3 {
		font-size: 1rem;
		padding-top: 0.75rem;
		border-top: 2px solid var(--brand);
	}
	.welfare ul {
		margin: 0.6rem 0 0;
		padding-left: 1.1rem;
		font-size: 0.95rem;
		color: var(--muted);
	}
	.welfare li + li {
		margin-top: 0.2rem;
	}
	.note {
		margin: 2rem 0 0;
		font-size: 0.95rem;
	}
	.contact p {
		margin: 0;
	}
	.contact a {
		color: var(--brand);
	}
	.addr {
		margin-top: 0.75rem !important;
		font-size: 0.9rem;
		color: var(--muted);
	}
</style>
