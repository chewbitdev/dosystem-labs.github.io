---
import { CATEGORIES } from '../consts';

const path = Astro.url.pathname;
const links = [
	{ href: '/', label: '전체 글', active: path === '/' },
	...Object.entries(CATEGORIES).map(([key, c]) => ({
		href: `/category/${key}/`,
		label: c.label,
		active: path.startsWith(`/category/${key}`),
	})),
	{ href: '/about/', label: 'About', active: path.startsWith('/about') },
];
---

<header class="site-header">
	<div class="wrap bar">
		<a href="/" class="brand" aria-label="dosystem labs 홈">
			<img class="mark" src="/apple-touch-icon.png" alt="" width="24" height="24" />
			<span class="word">DO SYSTEM</span>
			<span class="sub">labs</span>
		</a>
		<nav aria-label="주요 메뉴">
			{
				links.map((l) => (
					<a href={l.href} class:list={{ active: l.active }} aria-current={l.active ? 'page' : undefined}>
						{l.label}
					</a>
				))
			}
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: color-mix(in srgb, var(--surface) 92%, transparent);
		backdrop-filter: saturate(160%) blur(10px);
		border-bottom: 1px solid var(--line);
	}
	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		min-height: 64px;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
		color: var(--ink);
		flex-shrink: 0;
	}
	.mark {
		width: 24px;
		height: 24px;
		border-radius: 4px;
	}
	.word {
		font-weight: 800;
		letter-spacing: 0.02em;
		font-size: 1.05rem;
	}
	.sub {
		color: var(--muted);
		font-weight: 500;
	}
	nav {
		display: flex;
		gap: 0.25rem;
		overflow-x: auto;
		scrollbar-width: none;
	}
	nav a {
		padding: 0.45rem 0.7rem;
		border-radius: 6px;
		text-decoration: none;
		color: var(--muted);
		font-size: 0.95rem;
		font-weight: 500;
		white-space: nowrap;
	}
	nav a:hover {
		color: var(--ink);
		background: var(--surface-alt);
	}
	nav a.active {
		color: var(--brand);
		font-weight: 700;
	}
	@media (max-width: 640px) {
		.bar {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.25rem;
			padding-block: 0.75rem 0.4rem;
		}
		nav {
			margin-inline: -0.7rem;
			max-width: calc(100% + 1.4rem);
		}
	}
</style>
