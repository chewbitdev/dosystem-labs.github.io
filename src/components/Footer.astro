---
import { COMPANY_URL, GITHUB_URL } from '../consts';
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="wrap inner">
		<div>
			<p class="name">DO SYSTEM labs</p>
			<p class="copy">© {year} DO SYSTEM. All rights reserved.</p>
		</div>
		<ul class="links">
			<li><a href={COMPANY_URL} target="_blank" rel="noopener">회사 홈페이지</a></li>
			<li><a href={GITHUB_URL} target="_blank" rel="noopener">GitHub</a></li>
			<li><a href="/rss.xml">RSS</a></li>
		</ul>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 6rem;
		border-top: 1px solid var(--line);
		background: var(--surface-alt);
		font-size: 0.9rem;
		color: var(--muted);
	}
	.inner {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 1.5rem;
		padding-block: 2.5rem;
	}
	p {
		margin: 0;
	}
	.name {
		color: var(--ink);
		font-weight: 700;
	}
	.links {
		display: flex;
		gap: 1.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.links a {
		text-decoration: none;
	}
	.links a:hover {
		color: var(--brand);
	}
</style>
