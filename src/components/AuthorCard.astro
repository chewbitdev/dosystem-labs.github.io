---
import type { CollectionEntry } from 'astro:content';

interface Props {
	author: CollectionEntry<'authors'>;
}
const { author } = Astro.props;
const { name, role, bio, github } = author.data;
const initial = name.trim().charAt(0).toUpperCase();
---

<aside class="author" aria-label="작성자">
	{
		github ? (
			<img src={`https://github.com/${github}.png?size=96`} alt="" width="56" height="56" loading="lazy" />
		) : (
			<span class="initial" aria-hidden="true">
				{initial}
			</span>
		)
	}
	<div>
		<p class="name">
			<a href={`/authors/${author.id}/`}>{name}</a>
			{role && <span class="role">{role}</span>}
		</p>
		{bio && <p class="bio">{bio}</p>}
		{
			github && (
				<a class="gh" href={`https://github.com/${github}`} target="_blank" rel="noopener">
					github.com/{github}
				</a>
			)
		}
	</div>
</aside>

<style>
	.author {
		display: flex;
		gap: 1rem;
		align-items: flex-start;
		padding: 1.5rem;
		border-radius: 10px;
		background: var(--surface-alt);
	}
	img,
	.initial {
		width: 56px;
		height: 56px;
		border-radius: 50%;
		flex-shrink: 0;
	}
	.initial {
		display: grid;
		place-items: center;
		background: var(--brand);
		color: #fff;
		font-weight: 700;
		font-size: 1.3rem;
	}
	p {
		margin: 0;
	}
	.name a {
		color: var(--ink);
		font-weight: 700;
		text-decoration: none;
	}
	.name a:hover {
		color: var(--brand);
	}
	.role {
		margin-left: 0.5rem;
		font-size: 0.85rem;
		color: var(--muted);
	}
	.bio {
		margin-top: 0.3rem;
		font-size: 0.95rem;
	}
	.gh {
		display: inline-block;
		margin-top: 0.4rem;
		font-size: 0.85rem;
		color: var(--muted);
	}
</style>
